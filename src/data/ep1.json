    },
    {
     "id": "e1t4_di7",
     "track": "dialogue",
     "start": 14.57,
     "duration": 0.7,
     "text": "No.",
     "voiceOf": "barbas"
    },
    {
     "id": "e1t4_di8",
     "track": "dialogue",
     "start": 14.63,
     "duration": 0.7,
     "text": "No.",
     "voiceOf": "jefe"
    },
    {
