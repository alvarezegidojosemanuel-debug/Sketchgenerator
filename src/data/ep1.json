  {
   "id": "e1t2",
   "name": "El viernes",
   "duration": 30.3,
   "backgroundId": "bg_oficina_manana",
   "actors": [],
   "events": [
    {
     "id": "e1t2_di1",
     "track": "dialogue",
     "start": 0.3,
     "duration": 1.4,
     "text": "¿Cambios? ¿Qué cambios?",
     "voiceOf": "jefe"
    },
    {
     "id": "e1t2_di2",
     "track": "dialogue",
     "start": 1.9,
     "duration": 4.5,
     "text": "Yo no digo nada, Jefe. Pero lo ha dicho mirando tu silla.",
     "voiceOf": "barbas"
    },
    {
     "id": "e1t2_di3",
     "track": "dialogue",
     "start": 6.9,
     "duration": 1.1,
     "text": "…¿Mi silla?",
     "voiceOf": "jefe"
    },
    {
     "id": "e1t2_di4",
     "track": "dialogue",
     "start": 8.25,
     "duration": 2.4,
     "text": "Con todo el amor del mundo.",
     "voiceOf": "barbas"
    },
    {
     "id": "e1t2_di5",
     "track": "dialogue",
     "start": 10.8,
     "duration": 1.4,
     "text": "[angry] ¡Voy ahora mismo!",
     "voiceOf": "jefe"
    },
    {
     "id": "e1t2_sf6",
     "track": "sfx",
     "start": 12.3,
     "duration": 0.6,
     "soundId": "sfx_whoosh"
    },
    {
     "id": "e1t2_di7",
     "track": "dialogue",
     "start": 13.5,
     "duration": 5.5,
     "text": "La reunión con él es el viernes, Jefe. Te lo he apuntado en la mano.",
     "voiceOf": "sister"
    },
    {
     "id": "e1t2_di8",
     "track": "dialogue",
     "start": 19.5,
     "duration": 1.4,
     "text": "…Pone «no grites».",
     "voiceOf": "jefe"
    },
    {
     "id": "e1t2_di9",
     "track": "dialogue",
     "start": 21.7,
     "duration": 2.8,
     "text": "Tranquilos. Lo arreglo yo. Con un parche.",
     "voiceOf": "usu"
    },
    {
     "id": "e1t2_di10",
     "track": "dialogue",
     "start": 24.65,
     "duration": 0.7,
     "text": "No.",
     "voiceOf": "sister"
    },
    {
     "id": "e1t2_di11",
     "track": "dialogue",
     "start": 24.71,
     "duration": 0.7,
     "text": "No.",
     "voiceOf": "reynaldo"
    },
    {
     "id": "e1t2_di12",
     "track": "dialogue",
     "start": 24.77,
     "duration": 0.7,
     "text": "No.",
     "voiceOf": "barbas"
    },
    {
     "id": "e1t2_di13",
     "track": "dialogue",
     "start": 24.83,
     "duration": 0.7,
     "text": "No.",
     "voiceOf": "jefe"
    },
    {
     "id": "e1t2_di14",
     "track": "dialogue",
     "start": 26.29,
     "duration": 1.8,
     "text": "Ya lo he empezado.",
     "voiceOf": "usu"
    },
    {
