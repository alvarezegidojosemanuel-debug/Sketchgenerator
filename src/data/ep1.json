   "id": "e1t1",
   "name": "La incidencia fantasma",
   "duration": 33.5,
   "backgroundId": "bg_oficina_manana",
   "actors": [],
   "events": [
    {
     "id": "e1t1_sf1",
     "track": "sfx",
     "start": 0.3,
     "duration": 3,
     "soundId": "sfx_teclado",
     "volume": 0.5
    },
    {
     "id": "e1t1_di2",
     "track": "dialogue",
     "start": 0.3,
     "duration": 5.6,
     "text": "Departamento de soporte. Cinco personas. Y una incidencia que no hay manera de cerrar."
    },
    {
     "id": "e1t1_di3",
     "track": "dialogue",
     "start": 6.25,
     "duration": 4.9,
     "text": "La cuatro mil doce se ha vuelto a abrir. Sola. Otra vez.",
     "voiceOf": "sister"
    },
    {
     "id": "e1t1_di4",
     "track": "dialogue",
     "start": 11.5,
     "duration": 5.3,
     "text": "Yo la cerré ayer a las seis menos uno. Consta en el registro.",
     "voiceOf": "reynaldo"
    },
    {
     "id": "e1t1_di5",
     "track": "dialogue",
     "start": 17.15,
     "duration": 6.4,
     "text": "Igual es que le caemos bien. Te lo digo con todo el amor del mundo, ¿eh?",
     "voiceOf": "barbas"
    },
    {
     "id": "e1t1_di6",
     "track": "dialogue",
     "start": 23.9,
     "duration": 2.4,
     "text": "O el servidor tiene sentimientos.",
     "voiceOf": "usu"
    },
    {
     "id": "e1t1_sf7",
     "track": "sfx",
     "start": 26.65,
     "duration": 0.6,
     "soundId": "sfx_ding"
    },
    {
     "id": "e1t1_di8",
     "track": "dialogue",
     "start": 27.05,
     "duration": 4.9,
     "text": "Equipo de soporte: si la incidencia sigue abierta el viernes, habrá cambios.",
     "speakerName": "Director"
    },
    {
