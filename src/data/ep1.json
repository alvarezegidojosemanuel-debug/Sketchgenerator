  {
   "id": "e1t2",
   "name": "Barbas calienta al Jefe",
   "duration": 17.5,
   "backgroundId": "bg_oficina_manana",
   "actors": [],
   "events": [
    {
     "id": "e1t2_di1",
     "track": "dialogue",
     "start": 0.3,
     "duration": 1.4,
     "text": "¿Cambios? ¿Qué cambios?",
