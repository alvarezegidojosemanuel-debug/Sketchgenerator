   "name": "La incidencia fantasma",
   "duration": 26.6,
   "backgroundId": "bg_oficina_manana",
   "actors": [],
   "events": [
    {
     "id": "e1t1_sf1",
     "track": "sfx",
     "start": 0.3,
     "duration": 3,
     "soundId": "sfx_teclado",
     "volume": 0.5
    },
    {
     "id": "e1t1_di2",
     "track": "dialogue",
     "start": 0.3,
     "duration": 5.2,
     "text": "Departamento de soporte. Cinco personas. Y una incidencia que no hay manera de cerrar."
    },
    {
     "id": "e1t1_di3",
     "track": "dialogue",
     "start": 5.85,
     "duration": 4.5,
     "text": "La cuatro mil doce se ha vuelto a abrir. Sola. Otra vez.",
     "voiceOf": "sister"
    },
    {
     "id": "e1t1_di4",
     "track": "dialogue",
     "start": 10.7,
     "duration": 4.8,
     "text": "Yo la cerré ayer a las seis menos uno. Consta en el registro.",
     "voiceOf": "reynaldo"
    },
    {
     "id": "e1t1_di5",
     "track": "dialogue",
     "start": 15.85,
     "duration": 2.4,
     "text": "[mischievously] Igual es que le caemos bien.",
     "voiceOf": "barbas"
    },
    {
     "id": "e1t1_di6",
     "track": "dialogue",
     "start": 18.6,
     "duration": 2.1,
     "text": "O el servidor tiene sentimientos.",
     "voiceOf": "usu"
    },
    {
     "id": "e1t1_sf7",
     "track": "sfx",
     "start": 20.9,
     "duration": 0.6,
     "soundId": "sfx_ding"
    },
    {
     "id": "e1t1_di8",
     "track": "dialogue",
     "start": 21.3,
     "duration": 4.5,
     "text": "Equipo de soporte: si la incidencia sigue abierta el viernes, habrá cambios.",
     "speakerName": "Director"
    },
