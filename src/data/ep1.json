   "events": [
    {
     "id": "e1t4_di1",
     "track": "dialogue",
     "start": 1.4,
     "duration": 3.8,
     "text": "Reunión con el Director, el viernes a las diez. Apuntada.",
     "voiceOf": "sister"
    },
    {
     "id": "e1t4_di2",
     "track": "dialogue",
     "start": 5.6,
     "duration": 1.1,
     "text": "¿Qué reunión?",
     "voiceOf": "jefe"
    },
    {
     "id": "e1t4_di3",
     "track": "dialogue",
     "start": 7.4,
     "duration": 3.5,
     "text": "[mischievously] La tuya, Jefe. Con todo el amor del mundo.",
     "voiceOf": "barbas"
    },
    {
     "id": "e1t4_di4",
     "track": "dialogue",
     "start": 11.5,
     "duration": 2.8,
