  {
   "id": "e1t2",
   "name": "El viernes",
   "duration": 32.4,
   "backgroundId": "bg_oficina_manana",
   "actors": [],
   "events": [
    {
     "id": "e1t2_di1",
     "track": "dialogue",
     "start": 0.3,
     "duration": 1.7,
     "text": "¿Cambios? ¿Qué cambios?",
     "voiceOf": "jefe"
    },
    {
     "id": "e1t2_di2",
     "track": "dialogue",
     "start": 2.35,
     "duration": 7.4,
     "text": "Jefe, lo ha dicho con un tonito… Con todo el amor del mundo: yo iría a hablar con él.",
     "voiceOf": "barbas"
    },
    {
     "id": "e1t2_di3",
     "track": "dialogue",
     "start": 10.1,
     "duration": 1.7,
     "text": "[angry] ¡Voy ahora mismo!",
     "voiceOf": "jefe"
    },
    {
     "id": "e1t2_sf4",
     "track": "sfx",
     "start": 12.15,
     "duration": 0.6,
     "soundId": "sfx_whoosh"
    },
    {
     "id": "e1t2_di5",
     "track": "dialogue",
     "start": 12.15,
     "duration": 5.6,
     "text": "Jefe, la reunión con él es el viernes. Te lo apunté en tres sitios.",
     "voiceOf": "sister"
    },
    {
     "id": "e1t2_di6",
     "track": "dialogue",
     "start": 18.1,
     "duration": 1.3,
     "text": "¿Qué reunión?",
     "voiceOf": "jefe"
    },
    {
     "id": "e1t2_di7",
     "track": "dialogue",
     "start": 20.05,
     "duration": 3.1,
     "text": "Tranquilos. Lo arreglo yo. Con un parche.",
     "voiceOf": "usu"
    },
    {
     "id": "e1t2_di8",
     "track": "dialogue",
     "start": 23.5,
     "duration": 1.2,
     "text": "No.",
     "voiceOf": "sister"
    },
    {
     "id": "e1t2_di9",
     "track": "dialogue",
     "start": 24.85,
     "duration": 1.2,
     "text": "No.",
     "voiceOf": "reynaldo"
    },
    {
     "id": "e1t2_di10",
     "track": "dialogue",
     "start": 26.2,
     "duration": 1.2,
     "text": "No.",
     "voiceOf": "barbas"
    },
    {
     "id": "e1t2_di11",
     "track": "dialogue",
     "start": 28.0,
     "duration": 2.0,
     "text": "Ya lo he empezado.",
     "voiceOf": "usu"
    },
    {
