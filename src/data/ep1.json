     "id": "e1t2_di2",
     "track": "dialogue",
     "start": 1.9,
     "duration": 4.5,
     "text": "[mischievously] Yo no digo nada, Jefe… pero lo ha dicho mirando tu silla.",
     "voiceOf": "barbas"
    },
    {
     "id": "e1t2_di3",
     "track": "dialogue",
     "start": 6.9,
     "duration": 1.1,
     "text": "…¿Mi silla?",
