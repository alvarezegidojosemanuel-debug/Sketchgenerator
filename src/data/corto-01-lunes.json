      "pasos": [
        {
          "dice": "Sister",
          "texto": "Jefe, la reunión de las diez. Te la he puesto en el móvil, en el calendario y en un pósit.",
          "gesto": "movil",
          "pausa_despues": 0.05
        },
        {
          "dice": "Jefe",
          "texto": "¿Qué reunión?",
          "gesto": "confundido",
          "pausa_despues": 0.05
        },
        {
          "entra": "Director"
        },
        {
          "dice": "Director",
          "texto": "¡Mira! ¡Aquí está mi equipo de nerds favorito!",
          "gesto": "explica",
          "pausa_despues": 0.05
        },
        {
          "dice": "Director",
          "texto": "A ti, Jefe, te estaba buscando.",
          "gesto": "senala",
          "pausa_despues": 0.05
        },
        {
          "dice": "Director",
          "texto": "Este viernes presentamos ÍCARO ante los inversores. Y no puede fallar nada.",
          "gesto": "explica",
          "pausa_despues": 0.05
        },
        {
          "dice": "Director",
          "texto": "Más te vale que no pierda ese contrato por vuestra incompetencia.",
          "gesto": "grita_senala",
          "pausa_despues": 0.05
        },
        {
          "dice": "Director",
          "texto": "¡Así que lo quiero todo funcionando!",
          "gesto": "grita",
          "pausa_despues": 0.05
        },
        {
          "dice": "Jefe",
          "texto": "¿ÍCARO? Umm… Vale, vale. Todo saldrá bien, no se preocupe.",
          "gesto": "explica",
          "pausa_despues": 0.05
        },
        {
          "dice": "Director",
          "texto": "Más te vale…",
          "gesto": "neutro",
          "pausa_despues": 0.05
        },
        {
          "sale": "Director"
        },
        {
          "dice": "Sister",
          "texto": "Jefe, no sabes de qué te está hablando, ¿verdad?",
          "gesto": "explica",
          "pausa_despues": 0.05
        },
        {
          "dice": "Jefe",
          "texto": "Pues no…",
          "gesto": "confundido",
          "pausa_despues": 0.05
        },
        {
          "dice": "Sister",
          "texto": "Ay, Dios… Nada, ya te envío un correo con todo el estado del proyecto.",
          "gesto": "movil",
          "pausa_despues": 0.05
        },
        {
          "dice": "Barbas",
          "texto": "Yo no sé, Jefe, pero me parece una puta vergüenza que nos trate así ese psicópata.",
          "gesto": "explica",
          "pausa_despues": 0.05
        },
        {
          "dice": "Barbas",
          "texto": "Deberías ir a hablar con él y dejárselo claro.",
          "gesto": "senala",
          "pausa_despues": 0.05
        },
        {
          "dice": "Jefe",
          "texto": "¡Sí, es cierto! Luego iré a su despacho y le pondré en su sitio.",
          "gesto": "explica",
          "pausa_despues": 0.05
        },
        {
          "off": "Anastas-IA",
          "texto": "Recordatorio: la productividad mejora con descansos. Usu, has trabajado muy bien hoy.",
          "pausa_despues": 0.1
        },
        {
          "mira": "Barbas",
          "a": "Usu"
        },
        {
          "dice": "Barbas",
          "texto": "¡Pero si solo son las nueve y cinco!",
