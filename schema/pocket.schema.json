{
  "$id": "https://punetos-pocket.local/schema/pocket.schema.json",
  "title": "PUÑETOS Pocket project (pocket-1)",
  "description": "Contrato JSON canónico de PUÑETOS Pocket. Campos propuestos para Pocket; no equivalen automáticamente al esquema V3/V8. Los IDs (characterId, poseId, expressionId, backgroundId, propId) deben existir en el catálogo de la versión indicada.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "pocket-1"
    },
    "catalogVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "metadata": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "language": {
          "default": "es-ES",
          "type": "string",
          "minLength": 2,
          "maxLength": 20
        },
        "approxDuration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 180
        },
        "idea": {
          "type": "string",
          "maxLength": 1000
        },
        "voices": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "voiceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "speaker": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20
              },
              "pitch": {
                "type": "number",
                "minimum": 0.7,
                "maximum": 1.4
              },
              "speed": {
                "type": "number",
                "minimum": 0.6,
                "maximum": 1.6
              }
            },
            "required": [
              "voiceId",
              "pitch",
              "speed"
            ]
          }
        },
        "elevenVoices": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "voiceId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9]{8,40}$"
              },
              "name": {
                "type": "string",
                "maxLength": 80
              },
              "stability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "similarity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "style": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "speed": {
                "type": "number",
                "minimum": 0.7,
                "maximum": 1.2
              }
            },
            "required": [
              "voiceId",
              "stability",
              "similarity",
              "style",
              "speed"
            ]
          }
        },
        "wishlist": {
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          }
        }
      },
      "required": [
        "title",
        "approxDuration"
      ]
    },
    "canvas": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "const": 1080
        },
        "height": {
          "type": "number",
          "const": 1920
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "takes": {
      "minItems": 1,
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 60
          },
          "backgroundId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "actors": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "uid": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "characterId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "poseId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "x": {
                  "type": "number",
                  "minimum": -600,
                  "maximum": 1680
                },
                "y": {
                  "type": "number",
                  "minimum": -600,
                  "maximum": 2520
                },
                "scale": {
                  "default": 1,
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 4
                },
                "zIndex": {
                  "default": 0,
                  "type": "integer",
                  "minimum": -100,
                  "maximum": 100
                },
                "flip": {
                  "type": "boolean"
                },
                "expressionId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                }
              },
              "required": [
                "uid",
                "characterId",
                "poseId",
                "x",
                "y"
              ]
            }
          },
          "events": {
            "maxItems": 200,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "duration": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "track": {
                      "type": "string",
                      "const": "dialogue"
                    },
                    "actorUid": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 280
                    },
                    "voice": {
                      "type": "object",
                      "properties": {
                        "rate": {
                          "type": "number",
                          "minimum": 0.5,
                          "maximum": 2
                        },
                        "pitch": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 2
                        },
                        "voiceName": {
                          "type": "string",
                          "maxLength": 120
                        }
                      }
                    }
                  },
                  "required": [
                    "id",
                    "start",
                    "duration",
                    "track",
                    "actorUid",
                    "text"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "duration": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "track": {
                      "type": "string",
                      "const": "body"
                    },
                    "actorUid": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "poseId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "x": {
                      "type": "number",
                      "minimum": -600,
                      "maximum": 1680
                    },
                    "y": {
                      "type": "number",
                      "minimum": -600,
                      "maximum": 2520
                    },
                    "scale": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 4
                    },
                    "flip": {
                      "type": "boolean"
                    },
                    "ease": {
                      "type": "string",
                      "enum": [
                        "linear",
                        "inOut",
                        "instant"
                      ]
                    },
                    "fx": {
                      "type": "string",
                      "enum": [
                        "shake",
                        "jump"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "start",
                    "duration",
                    "track",
                    "actorUid"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "duration": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "track": {
                      "type": "string",
                      "const": "face"
                    },
                    "actorUid": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "expressionId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "emotion": {
                      "type": "string",
                      "maxLength": 40
                    }
                  },
                  "required": [
                    "id",
                    "start",
                    "duration",
                    "track",
                    "actorUid"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "duration": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "track": {
                      "type": "string",
                      "const": "mouth"
                    },
                    "actorUid": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "auto",
                        "calibrated"
                      ]
                    },
                    "dx": {
                      "type": "number",
                      "minimum": -400,
                      "maximum": 400
                    },
                    "dy": {
                      "type": "number",
                      "minimum": -400,
                      "maximum": 400
                    }
                  },
                  "required": [
                    "id",
                    "start",
                    "duration",
                    "track",
                    "actorUid",
                    "mode"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "duration": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "track": {
                      "type": "string",
                      "const": "eyes"
                    },
                    "actorUid": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "gazeX": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    },
                    "gazeY": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "id",
                    "start",
                    "duration",
                    "track",
                    "actorUid",
                    "gazeX",
                    "gazeY"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "duration": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "track": {
                      "type": "string",
                      "const": "props"
                    },
                    "actorUid": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "propId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "layer": {
                      "type": "string",
                      "enum": [
                        "props-back",
                        "props-front"
                      ]
                    },
                    "x": {
                      "type": "number",
                      "minimum": -600,
                      "maximum": 1680
                    },
                    "y": {
                      "type": "number",
                      "minimum": -600,
                      "maximum": 2520
                    },
                    "scale": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 4
                    },
                    "zIndex": {
                      "type": "integer",
                      "minimum": -100,
                      "maximum": 100
                    },
                    "rot": {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    },
                    "flip": {
                      "type": "boolean"
                    },
                    "enter": {
                      "type": "string",
                      "enum": [
                        "none",
                        "pop",
                        "fade",
                        "slide"
                      ]
                    },
                    "exit": {
                      "type": "string",
                      "enum": [
                        "none",
                        "pop",
                        "fade",
                        "slide"
                      ]
                    },
                    "loop": {
                      "type": "string",
                      "enum": [
                        "none",
                        "shake",
                        "pulse",
                        "blink",
                        "float",
                        "spin"
                      ]
                    },
                    "toX": {
                      "type": "number",
                      "minimum": -600,
                      "maximum": 1680
                    },
                    "toY": {
                      "type": "number",
                      "minimum": -600,
                      "maximum": 2520
                    },
                    "bubbleOf": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    }
                  },
                  "required": [
                    "id",
                    "start",
                    "duration",
                    "track",
                    "propId",
                    "layer",
                    "x",
                    "y"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "duration": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "track": {
                      "type": "string",
                      "const": "sfx"
                    },
                    "soundId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "volume": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "actorUid": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    }
                  },
                  "required": [
                    "id",
                    "start",
                    "duration",
                    "track",
                    "soundId"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "duration": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "track": {
                      "type": "string",
                      "const": "screen"
                    },
                    "effect": {
                      "type": "string",
                      "enum": [
                        "flash",
                        "shake",
                        "darken"
                      ]
                    },
                    "color": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "actorUid": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    }
                  },
                  "required": [
                    "id",
                    "start",
                    "duration",
                    "track",
                    "effect"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "duration",
          "backgroundId",
          "actors",
          "events"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "catalogVersion",
    "metadata",
    "canvas",
    "takes"
  ]
}
