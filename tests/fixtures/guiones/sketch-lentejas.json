{
  "formato": "puñetos-guion-1",
  "titulo": "Las lentejas",
  "idea": "Barbas calienta al Jefe con un táper desaparecido… y las cámaras de Usu lo aclaran todo.",
  "escenas": [
    {
      "nombre": "Sistemas, hora de comer",
