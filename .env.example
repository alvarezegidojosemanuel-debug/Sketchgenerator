# PUÑETOS Pocket — variables de entorno (copiar a .env.local o configurar en Vercel).
# NUNCA uses el prefijo NEXT_PUBLIC_ para ninguna de estas: deben quedarse en el servidor.

# --- OpenRouter (opcional, desactivado por defecto) ---
# Pon "true" solo si quieres habilitar /api/generate. Sin esto el endpoint responde 503 y no llama a nadie.
OPENROUTER_ENABLED=false
# Clave privada. Solo en Vercel → Settings → Environment Variables (no la subas a GitHub).
OPENROUTER_API_KEY=
# Solo se aceptan "openrouter/free" o IDs terminados en ":free". Cualquier otro valor se rechaza.
OPENROUTER_MODEL=openrouter/free
# Límites del servidor
OPENROUTER_TIMEOUT_MS=45000
OPENROUTER_MAX_TOKENS=4000
OPENROUTER_MAX_PROMPT_CHARS=24000
# Peticiones por IP y por ventana de 10 minutos
OPENROUTER_RATE_LIMIT_PER_IP=5
# Cuota diaria total del despliegue (OpenRouter free documenta ~50/día; revisa sus condiciones actuales)
OPENROUTER_DAILY_QUOTA=40
