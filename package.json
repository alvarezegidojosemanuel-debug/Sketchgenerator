{
  "name": "punetos-pocket",
  "version": "0.1.0",
  "private": true,
  "description": "PUÑETOS Pocket — web móvil para convertir una idea cómica en un sketch editable y reproducible.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:schema": "tsx scripts/gen-schema.ts",
    "gen:placeholder": "node scripts/make-placeholder-catalog.mjs",
    "catalog:v3": "node scripts/build-catalog-from-v3.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "next": "^15.5.27",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
